# Hostinger Business Web Hosting Environment Variables
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://browsergames100.com
SITE_URL=https://browsergames100.com

# MySQL Database Details (from Hostinger hPanel > Databases > MySQL Databases)
